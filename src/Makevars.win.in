TARGET = @TARGET@

PROFILE = @PROFILE@
FEATURE_FLAGS = @FEATURE_FLAGS@

# Add flags if necessary
RUSTFLAGS =

TARGET_DIR = $(CURDIR)/rust/target
LIBDIR = $(TARGET_DIR)/$(TARGET)/$(subst dev,debug,$(PROFILE))
STATLIB = $(LIBDIR)/libselectrs.a
PKG_LIBS = -L$(LIBDIR) -lselectrs -lws2_32 -ladvapi32 -luserenv -lbcrypt -lntdll

# Used by the vendored (CRAN) build path: the crate sources are extracted
# to VENDOR_DIR and CARGO_HOME is redirected to a throwaway directory under
# the build directory, so nothing is written to the user's home and no
# network access happens (CRAN policy). Both are removed after the build.
CARGOTMP = $(CURDIR)/.cargo
VENDOR_DIR = $(CURDIR)/rust/vendor

# CRAN allows at most two cores; cargo runs from ./rust (see the recipe).
CARGO_BUILD_ARGS = --lib -j 2 --profile $(PROFILE) $(FEATURE_FLAGS) --manifest-path Cargo.toml --target-dir $(TARGET_DIR)

# Rtools doesn't have the linker in the location that cargo expects, so we need
# to overwrite it via configuration.
CARGO_LINKER = x86_64-w64-mingw32.static.posix-gcc.exe

all: $(SHLIB) clean_intermediate

$(SHLIB): $(STATLIB)

$(STATLIB):
	# When the GNU toolchain is used (i.e. on CRAN), -lgcc_eh is specified for
	# building proc-macro2, but Rtools doesn't contain libgcc_eh. This isn't used
	# in actual, but we need this tweak to please the compiler.
	mkdir -p $(LIBDIR)/libgcc_mock && touch $(LIBDIR)/libgcc_mock/libgcc_eh.a

	# The CRAN source tarball ships the crate dependencies as
	# rust/vendor.tar.xz (regenerated by tools/vendor-crates.sh). When the
	# archive is present, extract it and install a config redirecting
	# crates-io to the vendored sources into the throwaway CARGO_HOME, so
	# the build below runs fully offline.
	if [ -f ./rust/vendor.tar.xz ]; then \
	  $(TAR) --extract --xz -f ./rust/vendor.tar.xz -C ./rust && \
	  mkdir -p "$(CARGOTMP)" && \
	  sed -e "s|@VENDOR_DIR@|$(VENDOR_DIR)|" ./cargo_vendor_config.toml > "$(CARGOTMP)/config.toml"; \
	fi

	if [ -f ./rust/vendor.tar.xz ]; then \
	  export CARGO_HOME="$(CARGOTMP)"; \
	fi && \
	  export CARGO_TARGET_X86_64_PC_WINDOWS_GNU_LINKER="$(CARGO_LINKER)" && \
	  export LIBRARY_PATH="$${LIBRARY_PATH};$(LIBDIR)/libgcc_mock" && \
	  export CC="$(CC)" && \
	  export CFLAGS="$(CFLAGS)" && \
	  export RUSTFLAGS="$(RUSTFLAGS)" && \
	  cd ./rust && \
	  if [ -f ./vendor.tar.xz ]; then \
	    cargo build --offline --target $(TARGET) $(CARGO_BUILD_ARGS); \
	  else \
	    cargo build --target $(TARGET) $(CARGO_BUILD_ARGS); \
	  fi
	if [ -f ./rust/vendor.tar.xz ]; then \
	  rm -Rf "$(CARGOTMP)" "$(VENDOR_DIR)"; \
	fi

clean_intermediate: $(SHLIB)
	rm -f $(STATLIB)

clean:
	rm -Rf $(SHLIB) $(OBJECTS) $(STATLIB) $(CARGOTMP) $(VENDOR_DIR) ./rust/target

.PHONY: all clean_intermediate clean
