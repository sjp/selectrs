CARGO_VERSION="$(cargo --version)"

if [ $? -ne 0 ]; then
  echo "-------------- ERROR: CONFIGURATION FAILED --------------------"
  echo ""
  echo "The cargo command is not available. To install Rust, please refer"
  echo "to the official instruction:"
  echo ""
  echo "https://www.rust-lang.org/tools/install"
  echo ""
  echo "---------------------------------------------------------------"

  exit 1
fi

# There's a little chance that rustc is not available on PATH while cargo is.
# So, just ignore the error case.
RUSTC_VERSION="$(rustc --version || true)"

# Report the version of Rustc to comply with the CRAN policy
echo "using Rust package manager: '${CARGO_VERSION}'"
echo "using Rust compiler: '${RUSTC_VERSION}'"

# The target has to match the architecture of the R that will load the shared
# library rather than that of the shell running this script, because an x86_64
# Rtools can be run under emulation on an ARM64 machine. Ask R, and fall back
# to the shell only when that fails.
#
# Rtools ships MinGW-w64 GCC for x86_64 but clang with MinGW-w64 for aarch64,
# hence the -gnu and -gnullvm triples. Neither the aarch64 target nor its
# linker name has been exercised here; set SELECTRS_CARGO_LINKER to override
# the linker. Both compiler names are Rtools42-and-later spellings, i.e. the
# UCRT toolchain, which is where DESCRIPTION's R (>= 4.2) floor comes from.
R_ARCH_NAME="$("${R_HOME}/bin/Rscript" --vanilla -e 'cat(R.version$arch)' 2>/dev/null || true)"
if [ -z "${R_ARCH_NAME}" ]; then
  R_ARCH_NAME="$(uname -m 2>/dev/null || true)"
fi

case "${R_ARCH_NAME}" in
  x86_64 | amd64 | AMD64)
    TARGET="x86_64-pc-windows-gnu"
    CARGO_LINKER_ENV="CARGO_TARGET_X86_64_PC_WINDOWS_GNU_LINKER"
    CARGO_LINKER="x86_64-w64-mingw32.static.posix-gcc.exe"
    ;;
  aarch64 | arm64 | ARM64)
    TARGET="aarch64-pc-windows-gnullvm"
    CARGO_LINKER_ENV="CARGO_TARGET_AARCH64_PC_WINDOWS_GNULLVM_LINKER"
    CARGO_LINKER="aarch64-w64-mingw32-clang.exe"
    ;;
  *)
    echo "-------------- ERROR: CONFIGURATION FAILED --------------------"
    echo ""
    echo "selectrs could not work out which Rust target to build for."
    if [ -z "${R_ARCH_NAME}" ]; then
      echo "The architecture of this machine could not be determined."
    else
      echo "This machine reports its architecture as '${R_ARCH_NAME}',"
      echo "which is neither x86_64 nor aarch64."
    fi
    echo ""
    echo "---------------------------------------------------------------"

    exit 1
    ;;
esac

if [ -n "${SELECTRS_CARGO_LINKER}" ]; then
  CARGO_LINKER="${SELECTRS_CARGO_LINKER}"
fi

echo "using Rust target: '${TARGET}'"
echo "using linker: '${CARGO_LINKER}'"

# Enforce the minimum supported Rust version (set by savvy 0.10.2, the
# newest rust-version requirement in the pinned dependency tree; declared
# as rust-version in src/rust/Cargo.toml). When rustc's version cannot be
# determined the check is skipped — cargo resolves rustc on its own and
# will fail with its own message if the toolchain is too old.
MIN_RUST_VERSION="1.88.0"
RUSTC_VERSION_NUMBER="$(echo "${RUSTC_VERSION}" | sed -n 's/^rustc \([0-9][0-9.]*\).*/\1/p')"
if [ -n "${RUSTC_VERSION_NUMBER}" ]; then
  if ! awk -v have="${RUSTC_VERSION_NUMBER}" -v need="${MIN_RUST_VERSION}" 'BEGIN {
      n = split(have, h, "."); m = split(need, w, ".");
      for (i = 1; i <= 3; i++) {
        hv = (i <= n) ? h[i] + 0 : 0; wv = (i <= m) ? w[i] + 0 : 0;
        if (hv > wv) exit 0;
        if (hv < wv) exit 1;
      }
      exit 0
    }'; then
    echo "-------------- ERROR: CONFIGURATION FAILED --------------------"
    echo ""
    echo "selectrs requires rustc >= ${MIN_RUST_VERSION} (found ${RUSTC_VERSION_NUMBER})."
    echo "Please update your Rust toolchain, e.g. with:"
    echo ""
    echo "    rustup update"
    echo ""
    echo "and make sure the Windows target is installed:"
    echo ""
    echo "    rustup target add ${TARGET}"
    echo ""
    echo "---------------------------------------------------------------"

    exit 1
  fi
fi

# allow overriding profile externally (e.g. on CI)
if [ -n "${SAVVY_PROFILE}" ]; then
  PROFILE="${SAVVY_PROFILE}"
# catch DEBUG envvar, which is passed from pkgbuild::compile_dll()
elif [ "${DEBUG}" = "true" ]; then
  PROFILE=dev
else
  PROFILE=release
fi

# e.g. SAVVY_FEATURES="a b"  -->  "--features 'a b'"
if [ -n "${SAVVY_FEATURES}" ]; then
  FEATURE_FLAGS="--features '${SAVVY_FEATURES}'"
fi

sed \
  -e "s/@TARGET@/${TARGET}/" \
  -e "s/@PROFILE@/${PROFILE}/" \
  -e "s/@FEATURE_FLAGS@/${FEATURE_FLAGS}/" \
  -e "s/@CARGO_LINKER_ENV@/${CARGO_LINKER_ENV}/" \
  -e "s|@CARGO_LINKER@|${CARGO_LINKER}|" \
  src/Makevars.win.in > src/Makevars.win
