{
	"name": "selectrs development",
	"image": "mcr.microsoft.com/devcontainers/base:trixie",
	"features": {
		"ghcr.io/rocker-org/devcontainer-features/r-apt:latest": {},
		"ghcr.io/devcontainers/features/node:": {
			"version": "26"
		},
		"ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {},
		"ghcr.io/devcontainers/features/rust:1": {}
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"REditorSupport.r-syntax",
				"RDebugger.r-debugger",
				"rust-lang.rust-analyzer"
			],
			"settings": {
				"rust-analyzer.server.path": "/usr/local/cargo/bin/rust-analyzer"
			}
		}
	},
	"mounts": [
		"source=claude-code-config,target=/home/vscode/.claude,type=volume"
	],
	"remoteUser": "vscode",
	"postCreateCommand": "sudo chown -R $(id -u):$(id -g) ~/.claude && echo '{\"hasCompletedOnboarding\":true,\"numStartups\":1,\"installMethod\":\"npm\"}' > ~/.claude.json",
}